{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		// ponytail: repete o rootDirs de $app/tsconfig relativo a este arquivo — em drive de rede
		// (S: -> \\ASILO\...) o TS resolve o extends pelo realpath UNC e os ./$types somem.
		"rootDirs": [".", ".svelte-kit/types"],
		"rewriteRelativeImportExtensions": true,
		"sourceMap": true,
		"strict": true
	},
	"include": ["src", "vite.config.ts"],
	"exclude": ["src/service-worker"]
}
